# Core application settings
# Source runs only: ./workshop.db is already the code default, while the image and compose always use /data/workshop.db.
# WORKSHOP_DATABASE_URL=sqlite+aiosqlite:///./workshop.db
WORKSHOP_DOCS_URL=/docs
WORKSHOP_REDOC_URL=/redoc
WORKSHOP_CORS_ALLOW_ORIGINS=["http://localhost:9090","http://127.0.0.1:9090"]

# Shared instance (leave both off for local single-user runs)
# Shared mode requires the admin token for workshop control operations on the default space.
# WORKSHOP_SHARED_MODE=false
# The bearer token for those operations; shared mode refuses to start without a non-empty value.
# WORKSHOP_ADMIN_TOKEN=

# AI configuration (defaults to mock provider for CI)
WORKSHOP_AI_PROVIDER=mock
WORKSHOP_AI_MODEL=mock-simulated
WORKSHOP_AI_API_KEY=
WORKSHOP_AI_BASE_URL=
WORKSHOP_AI_API_VERSION=

# Optional for OpenAI-compatible providers (fallbacks if WORKSHOP_* vars omitted)
# OPENAI_API_KEY=
# BASE_URL=https://api.openai.com/v1/
